---
interface Stat {
  number: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stat-row">
  {stats.map((stat) => (
    <div class="stat-card">
      <span class="stat-number">{stat.number}</span>
      <span class="stat-label">{stat.label}</span>
    </div>
  ))}
</div>
