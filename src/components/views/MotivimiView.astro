    kicker: { sq: 'Shpendët e ujit', en: 'Waterbirds', de: 'Wasservögel' },
    title: { sq: 'Pelikani kaçurrel', en: 'Dalmatian pelican', de: 'Krauskopfpelikan' },
    text: {
      sq: 'Një nga shpendët më të mëdhenj të ujit në rajon, i fotografuar te kripëtoret.',
