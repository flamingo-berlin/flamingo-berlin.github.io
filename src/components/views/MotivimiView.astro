const t = copy[lang];
const laguna = naturePhotos.laguna;
const heroAlt = {
  sq: 'Laguna e Nartës me një gadishull të vogël dhe male në sfond',
  en: 'Narta Lagoon with a small peninsula and mountains in the background',
  de: 'Die Narta-Lagune mit einer kleinen Halbinsel und Bergen im Hintergrund',
};
---

<BaseLayout lang={lang} title={`${t.title} · Flamingo Berlin`} description={t.natureHeading}>
  <Hero
    eyebrow={t.natureKicker}
    title={t.natureHeading}
    lede={t.natureLead}
    image={natureImg('laguna')}
    imageAlt={heroAlt[lang]}
    imageWidth={1920}
    imageHeight={1440}
    credit={{ text: `${t.heroCredit}: ${laguna.author}, ${laguna.license}`, href: laguna.source }}
    scrollTo="cfare-po-mbrojme"
    scrollLabel={t.scrollHint}
  />

  <SectionBand id="cfare-po-mbrojme" tone="paper" class="hero-overlap">
    <div class="tile-grid">
      {natureTiles.map((tile) => {
        const credit = naturePhotos[tile.photo];
        return (
          <figure class:list={['tile', { 'tile-wide': 'wide' in tile && tile.wide }]}>
            <img src={natureImg(tile.photo)} alt={tile.alt[lang]} loading="lazy" decoding="async" />
            <figcaption>
              <span class="tile-kicker">{tile.kicker[lang]}</span>
              <strong>{tile.title[lang]}</strong>
              <span class="tile-text">{tile.text[lang]}</span>
              <small>{t.heroCredit}: <a href={credit.source} target="_blank" rel="noreferrer">{credit.author}</a> · <a href={credit.licenseUrl} target="_blank" rel="noreferrer">{credit.license}</a></small>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </SectionBand>

  <SectionBand tone="tint">
    <div class="section-head">
      <p class="eyebrow">{t.kicker}</p>
      <h2>{t.h1}</h2>
      <p class="lede">{t.intro}</p>
    </div>
  </SectionBand>

  <SectionBand tone="grey">
    <h2>{t.memoHeading}</h2>
    <p>{t.memoIntro}</p>
    <ul>
      {t.memoPoints.map((point) => <li>{point}</li>)}
    </ul>
    <div class="memo-report-block">
      <h2>{t.reportHeading}</h2>
      <p>{t.reportLead}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={localePath(lang, '/memo/')}>📖 {t.readMemo}</a>
        <a class="btn" href="/assets/documents/Memo-FlamingoRevolution.pdf">⬇ {t.downloadPdf}</a>
      </div>
    </div>
  </SectionBand>

  <SectionBand tone="tint">
    <h2>{t.mapHeading}</h2>
    <p>{t.mapLead}</p>
    <div class="embedded-viewer">
      <iframe src="https://pomodoren.github.io/flamingo-map/" title={t.mapHeading} loading="lazy" allowfullscreen></iframe>
    </div>
    <div class="btn-row">
      <a class="btn" href="https://pomodoren.github.io/flamingo-map/" target="_blank" rel="noreferrer">↗ {t.mapOpen}</a>
    </div>
  </SectionBand>
</BaseLayout>
