---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBand from '../SectionBand.astro';
import type { Locale } from '../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;

const letterParagraphs = [
  '**Subjekti:** Shqetësim mbi mbrojtjen e zonave të mbrojtura dhe interesin publik në Shqipëri',
  'E nderuar Ambasadë e Republikës së Shqipërisë,',
  'Si qytetar shqiptar që jeton në Gjermani, dëshiroj të shpreh shqetësimin tim lidhur me zhvillimet e fundit që prekin zonat e mbrojtura, trashëgiminë natyrore dhe procesin e vendimmarrjes në Shqipëri.',
  'Besoj se mbrojtja e natyrës, transparenca institucionale dhe respektimi i ligjit janë vlera që duhet të mbrohen dhe promovohen në çdo rrethanë.',
  'Ju lutem që këtë shqetësim ta përcillni pranë institucioneve përkatëse në Shqipëri dhe të inkurajoni një dialog të hapur, transparent dhe gjithëpërfshirës mbi këto çështje.',
  'Faleminderit për kohën dhe vëmendjen tuaj.',
  'Me respekt,\n*Emri dhe Mbiemri*',
];

const copy = {
  sq: {
    title: 'Letra për Ambasadat',
    description: 'Model letre për Ambasadën e Republikës së Shqipërisë.',
    kicker: 'Vepro · Hapi 2',
    h1: 'Letra për Ambasadat',
    intro: 'Një mënyrë e thjeshtë për të kontribuar është t’i shkruash Ambasadës së Republikës së Shqipërisë. Kur shumë qytetarë shprehin shqetësimet e tyre në mënyrë të argumentuar dhe të respektueshme, mesazhi bëhet më i dukshëm dhe tregon se çështja ka interes të gjerë publik.',
    templateHeading: 'Model letre',
    stepsHeading: 'Si të veprosh?',
    steps: ['Kopjo tekstin e mësipërm.', 'Personalizoje me disa fjali personale, nëse dëshiron.', 'Dërgoje me email Ambasadës së Republikës së Shqipërisë në Berlin.'],
    contactHeading: 'Kontakti',
    contactName: 'Ambasada e Republikës së Shqipërisë në Berlin',
  },
  en: {
    title: 'Write to the Embassy',
    description: 'Template letter to the Embassy of the Republic of Albania.',
    kicker: 'Take action · Step 2',
    h1: 'Write to the Embassy',
    intro: 'One simple way to contribute is to write to the Embassy of the Republic of Albania. When many citizens express well-reasoned concerns respectfully, the issue becomes more visible.',
    templateHeading: 'Letter template (Albanian)',
    stepsHeading: 'How to proceed',
    steps: ['Copy the text above.', 'Personalize it with a few sentences if you wish.', 'Email it to the Embassy of the Republic of Albania in Berlin.'],
    contactHeading: 'Contact',
    contactName: 'Embassy of the Republic of Albania in Berlin',
  },
  de: {
    title: 'An die Botschaft schreiben',
    description: 'Musterschreiben an die Botschaft der Republik Albanien.',
    kicker: 'Aktiv werden · Schritt 2',
    h1: 'An die Botschaft schreiben',
    intro: 'Eine einfache Möglichkeit, dich zu beteiligen, ist ein Schreiben an die Botschaft der Republik Albanien. Wenn viele Bürgerinnen und Bürger ihre begründeten Bedenken respektvoll äußern, wird das Thema sichtbarer.',
    templateHeading: 'Musterschreiben (Albanisch)',
    stepsHeading: 'Vorgehen',
    steps: ['Kopiere den Text oben.', 'Ergänze auf Wunsch einige persönliche Sätze.', 'Sende ihn per E-Mail an die albanische Botschaft in Berlin.'],
    contactHeading: 'Kontakt',
    contactName: 'Botschaft der Republik Albanien in Berlin',
  },
} as const;

const t = copy[lang];
---

<BaseLayout lang={lang} title={`${t.title} · Flamingo Berlin`} description={t.description}>
  <SectionBand tone="tint" class="page-header">
    <div class="section-head">
      <p class="eyebrow">{t.kicker}</p>
      <h1>{t.h1}</h1>
      <p class="lede">{t.intro}</p>
    </div>
  </SectionBand>

  <SectionBand tone="grey">
    <h2>{t.templateHeading}</h2>
    <blockquote class="letter-quote">
      {letterParagraphs.map((para) => (
        <p set:html={para.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<em>$1</em>').replace(/\n/g, '<br>')} />
      ))}
    </blockquote>
  </SectionBand>

  <SectionBand tone="paper">
    <h2>{t.stepsHeading}</h2>
    <ol>
      {t.steps.map((step) => <li>{step}</li>)}
    </ol>
  </SectionBand>

  <SectionBand tone="tint">
    <h2>{t.contactHeading}</h2>
    <p><strong>{t.contactName}</strong></p>
    <div class="link-card-grid">
      <a class="link-card" href="mailto:embassy.berlin@mfa.gov.al"><span class="link-card-icon">📧</span> embassy.berlin@mfa.gov.al</a>
      <a class="link-card" href="https://ambasadaime.gov.al/germany" target="_blank" rel="noreferrer"><span class="link-card-icon">🌐</span> ambasadaime.gov.al/germany</a>
    </div>
  </SectionBand>
</BaseLayout>
