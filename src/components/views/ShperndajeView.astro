        { icon: '🗺️', label: 'Karte der Problembereiche', href: 'https://drive.google.com/file/d/1Meff2HT3KbijIayqyNYfP3C_qEUTBGb3/view?usp=sharing' },
      ]},
      { heading: 'PPNEA', links: [
        { icon: '🌿', label: 'PPNEA: Save Vjosa–Narta', href: 'https://ppnea.org/save-vjosa-narta/?lang=en' },
        { icon: '📁', label: 'Material von PPNEA', href: 'https://drive.google.com/drive/u/0/folders/1A5c-xrlWcqK1uC6fpBrGMSx5rUtwaHf7' },
        { icon: '📷', label: 'PPNEA auf Instagram', href: 'https://www.instagram.com/ppnea' },
      ]},
      { heading: 'Nachrichten und Dokumentation', links: [
        { icon: '📷', label: 'Protestat e Diasporës', href: 'https://www.instagram.com/protestat.e.diaspores' },
        { icon: '📷', label: 'News24 Albania', href: 'https://www.instagram.com/news24al' },
        { icon: '📷', label: 'Citizens.al', href: 'https://www.instagram.com/citizens.al' },
        { icon: '📷', label: 'Piranjat News', href: 'https://www.instagram.com/newspiranjat' },
      ]},
    ],
    howHeading: 'So kannst du helfen',
    how: [
      'Wähle ein Material und prüfe, ob es noch aktuell ist.',
      'Teile es auf Instagram, Facebook, LinkedIn, WhatsApp oder Discord.',
      'Ergänze einen persönlichen Satz dazu, warum dir das Thema wichtig ist.',
      'Füge den Link zum nächsten Protest hinzu.',
    ],
    quote: 'Ich teile dieses Material, um Naturschutz, Transparenz und das Gemeinwohl in Albanien zu unterstützen. Bitte lies und teile es weiter.',
  },
} as const;

const t = copy[lang];
---

<BaseLayout lang={lang} title={`${t.title} · Flamingo Berlin`} description={t.description}>
  <SectionBand tone="tint" class="page-header">
    <div class="section-head">
      <p class="eyebrow">{t.kicker}</p>
      <h1>{t.h1}</h1>
      <p class="lede">{t.intro}</p>
    </div>
  </SectionBand>

  <SectionBand tone="grey">
    {t.sections.slice(0, 2).map((section) => (
      <div class="link-group">
        <h3>{section.heading}</h3>
        <div class="link-card-grid">
          {section.links.map((link) => (
            <a class="link-card" href={link.href} target="_blank" rel="noreferrer">
              <span class="link-card-icon">{link.icon}</span> {link.label}
            </a>
          ))}
        </div>
      </div>
    ))}
  </SectionBand>

  <SectionBand tone="paper">
    {t.sections.slice(2).map((section) => (
      <div class="link-group">
        <h3>{section.heading}</h3>
        <div class="link-card-grid">
          {section.links.map((link) => (
            <a class="link-card" href={link.href} target="_blank" rel="noreferrer">
              <span class="link-card-icon">{link.icon}</span> {link.label}
            </a>
          ))}
        </div>
      </div>
    ))}
  </SectionBand>

  <SectionBand tone="tint">
    <h2>{t.howHeading}</h2>
    <ol>
      {t.how.map((step) => <li>{step}</li>)}
    </ol>

    <blockquote class="letter-quote">
      <p>{t.quote}</p>
    </blockquote>
  </SectionBand>
</BaseLayout>
