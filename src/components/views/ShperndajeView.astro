      ]},
      { heading: 'Background resources', links: [
        { icon: '📄', label: 'Article about the crisis', href: 'https://drive.google.com/file/d/1ApTOzTVWkUntmjF0e4DdXW_Vxi5DWvlG/view?usp=sharing' },
        { icon: '📄', label: 'Flamingo Revolution memo', href: 'https://drive.google.com/file/d/1vs-dqkhSW1zEq8_z3Wf5CMg3qcN_0ziI/view?usp=sharing' },
        { icon: '🗺️', label: 'Map of the issues', href: 'https://drive.google.com/file/d/1Meff2HT3KbijIayqyNYfP3C_qEUTBGb3/view?usp=sharing' },
      ]},
      { heading: 'PPNEA', links: [
        { icon: '🌿', label: 'Save Vjosa–Narta', href: 'https://ppnea.org/save-vjosa-narta/?lang=en' },
        { icon: '📁', label: 'Materials from PPNEA', href: 'https://drive.google.com/drive/u/0/folders/1A5c-xrlWcqK1uC6fpBrGMSx5rUtwaHf7' },
        { icon: '📷', label: 'PPNEA on Instagram', href: 'https://www.instagram.com/ppnea' },
      ]},
      { heading: 'News and documentation', links: [
        { icon: '📷', label: 'Diaspora Protests', href: 'https://www.instagram.com/protestat.e.diaspores' },
        { icon: '📷', label: 'News24 Albania', href: 'https://www.instagram.com/news24al' },
        { icon: '📷', label: 'Citizens.al', href: 'https://www.instagram.com/citizens.al' },
        { icon: '📷', label: 'Piranjat News', href: 'https://www.instagram.com/newspiranjat' },
      ]},
    ],
    howHeading: 'How to help',
    how: [
      'Choose a resource and check that it is still current.',
      'Share it on Instagram, Facebook, LinkedIn, WhatsApp or Discord.',
      'Add a personal sentence explaining why it matters to you.',
      'Include the link to the next protest.',
    ],
    quote: 'I am sharing this to support nature protection, transparency and the public interest in Albania. Please read and share it further.',
  },
  de: {
    title: 'Teilen',
    description: 'Links, Materialien und Quellen zum Teilen.',
    kicker: 'Aktiv werden · Schritt 1',
    h1: 'Teilen',
    intro: 'Hilf uns, mehr Menschen zu erreichen. Wähle eine Quelle, lies sie und teile sie in sozialen Netzwerken, Community-Gruppen oder direkt mit Interessierten.',
    sections: [
      { heading: 'Flamingo Revolution', links: [
        { icon: '📷', label: 'Flamingo Berlin auf Instagram', href: 'https://www.instagram.com/flamingosofberlin' },
