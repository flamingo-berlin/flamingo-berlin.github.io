    sections: [
      { heading: 'Flamingo Revolution', links: [
        { icon: '📷', label: 'Flamingo Berlin në Instagram', href: 'https://www.instagram.com/flamingosofberlin' },
        { icon: '🌐', label: 'Flamingot Vendosin', href: 'https://flamingotvendosin.org' },
        { icon: '📖', label: 'Flamingo Revolution në Wikipedia', href: 'https://en.wikipedia.org/wiki/Flamingo_Revolution' },
      ]},
      { heading: 'Materiale shpjeguese', links: [
        { icon: '📄', label: 'Artikulli mbi krizën', href: 'https://drive.google.com/file/d/1ApTOzTVWkUntmjF0e4DdXW_Vxi5DWvlG/view?usp=sharing' },
        { icon: '📄', label: 'Memo mbi Flamingo Revolution', href: 'https://drive.google.com/file/d/1vs-dqkhSW1zEq8_z3Wf5CMg3qcN_0ziI/view?usp=sharing' },
        { icon: '🗺️', label: 'Harta e problematikave', href: 'https://drive.google.com/file/d/1Meff2HT3KbijIayqyNYfP3C_qEUTBGb3/view?usp=sharing' },
      ]},
      { heading: 'PPNEA', links: [
        { icon: '🌿', label: 'Save Vjosa–Narta', href: 'https://ppnea.org/save-vjosa-narta/?lang=en' },
        { icon: '📁', label: 'Materiale nga PPNEA', href: 'https://drive.google.com/drive/u/0/folders/1A5c-xrlWcqK1uC6fpBrGMSx5rUtwaHf7' },
