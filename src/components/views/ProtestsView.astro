    nextDateLabel: 'Data',
    locationKicker: 'Vendndodhja',
    frequencyKicker: 'Ritmi',
    nextLocationLabel: 'Berlin',
    nextTimeNote: 'Ora dhe pika e mbledhjes konfirmohen në Instagram pak ditë përpara. Shto datën në kalendar që të mos e humbasësh njoftimin.',
    calendarCta: 'Shto në kalendar (Google)',
    icsCta: 'Shkarko .ics',
    latestBadge: 'Protesta e fundit',
    every: 'Çdo të diel',
    viewPost: 'Shiko postimin e fundit në Instagram',
    momentsKicker: 'Nga rruga',
    momentsHeading: 'Momente nga protestat',
    momentsLead: 'Pamje nga protestat dhe aktivitetet tona në Berlin.',
    galleryHint: 'Prek një foto për ta hapur të plotë',
    igKicker: 'Na ndiqni',
    igHeading: 'Nga Instagrami',
    igLead: 'Postimet më të fundit nga @flamingosofberlin.',
    igFollow: 'Ndiq @flamingosofberlin në Instagram',
    historyKicker: 'Arkiva',
    historyHeading: 'Historia e protestave',
    weekLabel: 'Java',
    sunday: 'E diel',
    joinKicker: 'Hapi tjetër',
    joinHeading: 'Merr pjesë',
    joinLead: 'Protestat tona janë paqësore dhe të hapura për të gjithë, dhe zhvillohen çdo të diel. Ndiq njoftimet tona për orën dhe vendndodhjen e aktivitetit të ardhshëm. 🦩',
    joinCta: 'Shiko si mund të reagosh',
  },
  en: {
    title: 'Protests',
    description: 'Protests and activities by Flamingo Berlin.',
    heroEyebrow: 'Flamingo Berlin · Albanian diaspora',
    h1: 'Protests in Berlin',
    lead: 'Peaceful protest, public information and solidarity with the Flamingo Revolution movement.',
    heroCta: 'See the next protest',
    heroSecondary: 'How you can help',
    heroCredit: 'Photo',
    nextBadge: 'Next protest',
    nextHeading: 'Protest!',
    nextSubheading: 'Join us next Sunday',
    nextDateLabel: 'Date',
    locationKicker: 'Location',
    frequencyKicker: 'Schedule',
    nextLocationLabel: 'Berlin',
    nextTimeNote: 'The time and meeting point are confirmed on Instagram a few days beforehand. Add the date to your calendar so you don’t miss the announcement.',
    calendarCta: 'Add to calendar (Google)',
    icsCta: 'Download .ics',
    latestBadge: 'Latest protest',
    every: 'Every Sunday',
    viewPost: 'View the latest post on Instagram',
    momentsKicker: 'From the street',
    momentsHeading: 'Moments from our protests',
    momentsLead: 'Photos from our protests and activities in Berlin.',
    galleryHint: 'Select a photo to open it at full size',
    igKicker: 'Follow us',
    igHeading: 'From Instagram',
    igLead: 'The latest posts from @flamingosofberlin.',
    igFollow: 'Follow @flamingosofberlin on Instagram',
    historyKicker: 'Archive',
    historyHeading: 'Protest history',
    weekLabel: 'Week',
    sunday: 'Sunday',
    joinKicker: 'Next step',
    joinHeading: 'Join us',
    joinLead: 'Our protests are peaceful, open to everyone and take place every Sunday. Follow our announcements for the time and location of the next activity. 🦩',
    joinCta: 'See how you can take action',
  },
  de: {
    title: 'Proteste',
    description: 'Proteste und Aktivitäten von Flamingo Berlin.',
    heroEyebrow: 'Flamingo Berlin · Albanische Diaspora',
    h1: 'Proteste in Berlin',
    lead: 'Friedlicher Protest, öffentliche Information und Solidarität mit der Flamingo-Revolution-Bewegung.',
    heroCta: 'Nächsten Protest ansehen',
    heroSecondary: 'So kannst du helfen',
    heroCredit: 'Foto',
    nextBadge: 'Nächster Protest',
    nextHeading: 'Protestiere!',
    nextSubheading: 'Mach nächsten Sonntag mit',
    nextDateLabel: 'Datum',
    locationKicker: 'Ort',
    frequencyKicker: 'Rhythmus',
    nextLocationLabel: 'Berlin',
    nextTimeNote: 'Uhrzeit und Treffpunkt werden wenige Tage vorher auf Instagram bestätigt. Trag dir das Datum in den Kalender ein, damit du die Ankündigung nicht verpasst.',
    calendarCta: 'Zum Kalender hinzufügen (Google)',
    icsCta: '.ics herunterladen',
    latestBadge: 'Letzter Protest',
    every: 'Jeden Sonntag',
    viewPost: 'Letzten Beitrag auf Instagram ansehen',
    momentsKicker: 'Von der Straße',
    momentsHeading: 'Momente unserer Proteste',
    momentsLead: 'Fotos von unseren Protesten und Aktivitäten in Berlin.',
    galleryHint: 'Foto auswählen, um es in voller Größe zu öffnen',
    igKicker: 'Folge uns',
    igHeading: 'Von Instagram',
    igLead: 'Die neuesten Beiträge von @flamingosofberlin.',
    igFollow: 'Folge @flamingosofberlin auf Instagram',
    historyKicker: 'Archiv',
    historyHeading: 'Protestchronik',
    weekLabel: 'Woche',
    sunday: 'Sonntag',
    joinKicker: 'Nächster Schritt',
    joinHeading: 'Mach mit',
    joinLead: 'Unsere Proteste sind friedlich, für alle offen und finden jeden Sonntag statt. Folge unseren Ankündigungen für Zeit und Ort der nächsten Aktion. 🦩',
    joinCta: 'So kannst du aktiv werden',
  },
} as const;

const t = copy[lang];
const photos = protestPhotos.map((p) => ({ src: `/assets/images/${p.file}`, alt: p.alt[lang] }));
const archive = protestArchive.map((entry) => localize(entry, lang));
const heroPhoto = naturePhotos['hero-flamingo'];
const heroAlt = {
  sq: 'Flamingo në fluturim mbi Lagunën e Nartës',
  en: 'A flamingo in flight over Narta Lagoon',
  de: 'Ein Flamingo im Flug über der Narta-Lagune',
};

// The next protest is always "the upcoming Sunday" — exact time and meeting
// point follow later on Instagram, so only the date is pinned here.
const nextDate = nextSunday();
const nextDateEnd = new Date(nextDate);
nextDateEnd.setUTCDate(nextDateEnd.getUTCDate() + 1);
const nextDateStart = toICSDate(nextDate);
const nextDateEndStr = toICSDate(nextDateEnd);
const dateFormatter = new Intl.DateTimeFormat(lang === 'sq' ? 'sq-AL' : lang === 'de' ? 'de-DE' : 'en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const nextDateLabel = dateFormatter.format(nextDate);
const dateLocale = lang === 'sq' ? 'sq-AL' : lang === 'de' ? 'de-DE' : 'en-GB';
const nextWeekday = new Intl.DateTimeFormat(dateLocale, { weekday: 'long', timeZone: 'UTC' }).format(nextDate);
const nextDay = new Intl.DateTimeFormat(dateLocale, { day: '2-digit', timeZone: 'UTC' }).format(nextDate);
const nextMonth = new Intl.DateTimeFormat(dateLocale, { month: 'short', timeZone: 'UTC' }).format(nextDate).replace('.', '');
const nextYear = new Intl.DateTimeFormat(dateLocale, { year: 'numeric', timeZone: 'UTC' }).format(nextDate);

const calendarTitle = { sq: 'Protesta e Flamingo Berlin', en: 'Flamingo Berlin protest', de: 'Protest von Flamingo Berlin' }[lang];
const calendarDetails = {
  sq: 'Protestë paqësore e Flamingo Berlin. Ora dhe pika e mbledhjes konfirmohen në Instagram: https://www.instagram.com/flamingosofberlin',
  en: 'Peaceful Flamingo Berlin protest. Time and meeting point confirmed on Instagram: https://www.instagram.com/flamingosofberlin',
  de: 'Friedlicher Protest von Flamingo Berlin. Uhrzeit und Treffpunkt werden auf Instagram bestätigt: https://www.instagram.com/flamingosofberlin',
}[lang];

const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(calendarTitle)}&dates=${nextDateStart}/${nextDateEndStr}&details=${encodeURIComponent(calendarDetails)}&location=${encodeURIComponent('Berlin')}`;

const icsBody = [
  'BEGIN:VCALENDAR',
  'VERSION:2.0',
  'PRODID:-//Flamingo Berlin//Protests//EN',
  'BEGIN:VEVENT',
  `UID:flamingo-berlin-protest-${nextDateStart}@flamingo.berlin`,
  `DTSTAMP:${toICSDate(new Date())}T000000Z`,
  `DTSTART;VALUE=DATE:${nextDateStart}`,
  `DTEND;VALUE=DATE:${nextDateEndStr}`,
  `SUMMARY:${calendarTitle}`,
  `DESCRIPTION:${calendarDetails.replace(/,/g, '\\,')}`,
  'LOCATION:Berlin',
  'END:VEVENT',
  'END:VCALENDAR',
].join('\r\n');
const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(icsBody)}`;
---

<BaseLayout lang={lang} title={`${t.title} · Flamingo Berlin`} description={t.description}>
  <Hero
    eyebrow={t.heroEyebrow}
    title={t.h1}
    lede={t.lead}
    image={natureImg('hero-flamingo')}
    imageAlt={heroAlt[lang]}
    imageWidth={1920}
    imageHeight={1280}
    actions={[
      { href: '#protesta-e-ardhshme', label: `${t.heroCta} ↓`, primary: true },
      { href: localePath(lang, '/vepro/'), label: `${t.heroSecondary} →` },
    ]}
    credit={{ text: `${t.heroCredit}: ${heroPhoto.author}, ${heroPhoto.license}`, href: heroPhoto.source }}
    scrollTo="protesta-e-ardhshme"
    scrollLabel={t.heroCta}
  />

  <SectionBand id="protesta-e-ardhshme" tone="grey" class="hero-overlap">
    <div class="section-head protest-section-head">
      <span class="protest-status">{t.nextBadge}</span>
      <h2>{t.nextHeading}</h2>
      <p class="lede">{t.nextSubheading}</p>
    </div>
    <div class="protest-event-card">
      <time class="protest-date" datetime={nextDate.toISOString().slice(0, 10)} aria-label={nextDateLabel}>
        <span class="protest-date-weekday">{nextWeekday}</span>
        <strong>{nextDay}</strong>
        <span class="protest-date-month">{nextMonth}</span>
        <span class="protest-date-year">{nextYear}</span>
      </time>
      <div class="protest-event-details">
        <div class="protest-facts">
          <div class="protest-fact">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>
            <span><small>{t.locationKicker}</small><strong>{t.nextLocationLabel}</strong></span>
          </div>
          <div class="protest-fact">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.1 9a7 7 0 0 1 11.6-2.6L20 9M4 15l2.3 2.6A7 7 0 0 0 17.9 15"/></svg>
            <span><small>{t.frequencyKicker}</small><strong>{t.every}</strong></span>
          </div>
        </div>
        <p class="protest-note">{t.nextTimeNote}</p>
        <div class="btn-row protest-actions">
          <a class="btn btn-primary" href={googleCalendarUrl} target="_blank" rel="noreferrer">{t.calendarCta}</a>
          <a class="btn" href={icsHref} download={`flamingo-berlin-${nextDateStart}.ics`}>{t.icsCta}</a>
        </div>
      </div>
    </div>
    <p class="protest-latest">{t.latestBadge}: <a href={latestProtest.href} target="_blank" rel="noreferrer">{t.viewPost} →</a></p>
  </SectionBand>

  <SectionBand tone="paper">
    <p class="eyebrow">{t.momentsKicker}</p>
    <h2>{t.momentsHeading}</h2>
    <p>{t.momentsLead}</p>
    <Gallery photos={photos} hint={t.galleryHint} />
  </SectionBand>

  <SectionBand tone="tint">
    <p class="eyebrow">{t.igKicker}</p>
    <h2>{t.igHeading}</h2>
    <p>{t.igLead}</p>
    <div class="instagram-grid">
      {instagramPosts.map((post) => (
        <a class="instagram-tile" href={post.href} target="_blank" rel="noreferrer" aria-label={t.viewPost}>
          <img src={`/assets/instagram/${post.image}`} alt="" loading="lazy" decoding="async" />
          <span class="instagram-icon" aria-hidden="true">📷</span>
        </a>
      ))}
    </div>
    <div class="btn-row">
      <a class="btn" href="https://www.instagram.com/flamingosofberlin" target="_blank" rel="noreferrer">{t.igFollow} →</a>
    </div>
  </SectionBand>

  <SectionBand tone="grey">
    <p class="eyebrow">{t.historyKicker}</p>
    <h2>{t.historyHeading}</h2>
    <ProtestArchive entries={archive} weekLabel={t.weekLabel} sundayLabel={t.sunday} />
  </SectionBand>

  <SectionBand tone="tint" class="cta-banner">
    <p class="eyebrow">{t.joinKicker}</p>
    <h2>{t.joinHeading}</h2>
    <p>{t.joinLead}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={localePath(lang, '/vepro/')}>{t.joinCta}</a>
    </div>
  </SectionBand>
</BaseLayout>
