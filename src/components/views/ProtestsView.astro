---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../Hero.astro';
import SectionBand from '../SectionBand.astro';
import Gallery from '../Gallery.astro';
import ProtestArchive from '../ProtestArchive.astro';
import { localePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import { latestProtest, protestArchive, protestPhotos, localize, nextSunday, toICSDate } from '../../data/protests';

interface Props { lang: Locale }
const { lang } = Astro.props;

// Hero photo of the Vjosë–Nartë Protected Landscape, the place the movement
// is named after and protests for. Reused from the Flamingo Revolution
// heritage site's Vjosë–Nartë page, credited under its original Wikimedia
// Commons license. The rest of the Vjosë–Nartë nature photos live on the
// Motivimi page now, which opens with them as its own hero.
const natureImg = (name: string) => `/assets/vjose-narta/${name}.jpg`;
const naturePhotos = {
  'hero-flamingo': { author: 'Arbenllapashtica', license: 'CC BY 4.0', licenseUrl: 'https://creativecommons.org/licenses/by/4.0/', source: 'https://commons.wikimedia.org/wiki/File:Laguna_e_Nart%C3%ABs_-_Vlor%C3%AB_(25).jpg' },
} as const;

// A curated set of recent posts about the movement, shown as a 3x3 photo
// gallery. Instagram's CDN sends `Cross-Origin-Resource-Policy: same-origin`
// on post images, so they can't be hotlinked into an <img> from this site —
// instead each thumbnail is saved locally (fetched once via
// `<permalink>media/?size=l`, no API token needed) and the tile links out to
// the real post (most are @flamingosofberlin; a couple are reposts/features
// from allied accounts, linked directly to their own permalink). Update both
// the permalink and image by hand when there's fresher content to show.
const instagramPosts = [
  { href: 'https://www.instagram.com/p/DdD-FulEQT2/', image: 'post-1.jpg' },
  { href: 'https://www.instagram.com/p/Dbn_6AFDKtp/', image: 'post-2.jpg' },
  { href: 'https://www.instagram.com/p/Ddl1OtkMdsF/', image: 'post-3.jpg' },
  { href: 'https://www.instagram.com/p/DdlBxLPDIsI/', image: 'post-4.jpg' },
  { href: 'https://www.instagram.com/p/Ddivpn_kaoD/', image: 'post-5.jpg' },
  { href: 'https://www.instagram.com/p/DdbXk_iDCA9/', image: 'post-6.jpg' },
  { href: 'https://www.instagram.com/ledjano_cela/p/DdYiLmFCKz5/', image: 'post-7.jpg' },
  { href: 'https://www.instagram.com/p/DdTcvpnkZam/', image: 'post-8.jpg' },
  { href: 'https://www.instagram.com/flamingos.of.munich/p/DdTTHmdtnd9/', image: 'post-9.jpg' },
];

const copy = {
  sq: {
    title: 'Protestat',
    description: 'Protestat dhe aktivitetet e Flamingo Berlin.',
    heroEyebrow: 'Flamingo Berlin · Diaspora shqiptare',
