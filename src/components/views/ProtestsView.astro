---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../Hero.astro';
import SectionBand from '../SectionBand.astro';
import StatRow from '../StatRow.astro';
import Gallery from '../Gallery.astro';
import ProtestArchive from '../ProtestArchive.astro';
import { localePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import { latestProtest, protestArchive, protestPhotos, localize, nextSunday, toICSDate } from '../../data/protests';

interface Props { lang: Locale }
const { lang } = Astro.props;

// Nature photos of the Vjosë–Nartë Protected Landscape, the place the
// movement is named after and protests for. Reused from the Flamingo
// Revolution heritage site's Vjosë–Nartë page, credited under their
// original Wikimedia Commons licenses.
const CC_BY = 'https://creativecommons.org/licenses/by/4.0/';
const CC_BY_SA = 'https://creativecommons.org/licenses/by-sa/4.0/';
const natureImg = (name: string) => `/assets/vjose-narta/${name}.jpg`;
const naturePhotos = {
  'hero-flamingo': { author: 'Arbenllapashtica', license: 'CC BY 4.0', licenseUrl: CC_BY, source: 'https://commons.wikimedia.org/wiki/File:Laguna_e_Nart%C3%ABs_-_Vlor%C3%AB_(25).jpg' },
  'flamingo-flock': { author: 'Arbenllapashtica', license: 'CC BY 4.0', licenseUrl: CC_BY, source: 'https://commons.wikimedia.org/wiki/File:Laguna_e_Nart%C3%ABs_-_Vlor%C3%AB_(2).jpg' },
  laguna: { author: 'Leeturtle', license: 'CC BY-SA 4.0', licenseUrl: CC_BY_SA, source: 'https://commons.wikimedia.org/wiki/File:Narta_lagoon,_southern_Albania.jpg' },
  'zvernec-ishulli': { author: 'Pasztilla (Attila Terbócs)', license: 'CC BY-SA 4.0', licenseUrl: CC_BY_SA, source: 'https://commons.wikimedia.org/wiki/File:Zv%C3%ABrnec_Island,_Albania_01.jpg' },
  pelikan: { author: 'gailhampshire', license: 'CC BY 2.0', licenseUrl: 'https://creativecommons.org/licenses/by/2.0/', source: 'https://commons.wikimedia.org/wiki/File:Dalmatian_Pelican._Pelecanus_crispus_(42882199270).jpg' },
  gaforre: { author: 'Pasztilla (Attila Terbócs)', license: 'CC BY-SA 4.0', licenseUrl: CC_BY_SA, source: 'https://commons.wikimedia.org/wiki/File:Narta_Lagoon,_Albania_%E2%80%93_Crab_01.jpg' },
  bregdeti: { author: 'Wildwheelwildsoul', license: 'CC0', licenseUrl: 'https://creativecommons.org/publicdomain/zero/1.0/', source: 'https://commons.wikimedia.org/wiki/File:The_Vjosa-Narte_Protected_Landscape_rocks.jpg' },
} as const;

// A small curated set of recent posts from @flamingosofberlin, shown as a
// photo gallery. Instagram's CDN sends `Cross-Origin-Resource-Policy:
// same-origin` on post images, so they can't be hotlinked into an <img> from
// this site — instead each thumbnail is saved locally (fetched once via
// `<permalink>media/?size=l`, no API token needed) and the tile links out to
// the real post. Update both the permalink and image by hand when there's
// fresher content to show.
const instagramPosts = [
  { href: 'https://www.instagram.com/p/DdD-FulEQT2/', image: 'post-1.jpg' },
  { href: 'https://www.instagram.com/p/Dbn_6AFDKtp/', image: 'post-2.jpg' },
  { href: 'https://www.instagram.com/p/Ddl1OtkMdsF/', image: 'post-3.jpg' },
];

const natureTiles = [
  {
    photo: 'flamingo-flock', wide: true,
    alt: { sq: 'Tufë flamingosh mbi ujin e Lagunës së Nartës', en: 'A flock of flamingos over the water of Narta Lagoon', de: 'Ein Flamingoschwarm über dem Wasser der Narta-Lagune' },
    kicker: { sq: 'Simboli i lëvizjes', en: 'Symbol of the movement', de: 'Symbol der Bewegung' },
    title: { sq: 'Flamingot e Nartës', en: 'The flamingos of Narta', de: 'Die Flamingos von Narta' },
    text: {
      sq: 'Zogu që i dha emrin lëvizjes nuk është vetëm simbol: është banor real i lagunës.',
      en: 'The bird that gave the movement its name is not just a symbol: it is a real resident of the lagoon.',
      de: 'Der Vogel, der der Bewegung ihren Namen gab, ist nicht nur ein Symbol: Er lebt wirklich in der Lagune.',
    },
  },
  {
    photo: 'laguna',
    alt: { sq: 'Laguna e Nartës me një gadishull të vogël dhe male në sfond', en: 'Narta Lagoon with a small peninsula and mountains in the background', de: 'Die Narta-Lagune mit einer kleinen Halbinsel und Bergen im Hintergrund' },
    kicker: { sq: 'Zonë e rëndësishme për shpendët', en: 'Important bird area', de: 'Wichtiges Vogelschutzgebiet' },
    title: { sq: 'Laguna e Nartës', en: 'Narta Lagoon', de: 'Lagune von Narta' },
    text: {
      sq: 'Laguna bregdetare pranë Vlorës, me mbi 200 lloje shpendësh të regjistruara.',
      en: 'A coastal lagoon near Vlorë, home to more than 200 recorded bird species.',
      de: 'Eine Küstenlagune bei Vlora mit mehr als 200 erfassten Vogelarten.',
    },
  },
  {
    photo: 'zvernec-ishulli',
    alt: { sq: 'Ishulli i Zvërnecit i mbuluar me pyll, parë nga një urë druri', en: 'The forested island of Zvërnec, seen from a wooden footbridge', de: 'Die bewaldete Insel Zvërnec, gesehen von einem Holzsteg' },
    kicker: { sq: 'Peizazh dhe trashëgimi', en: 'Landscape and heritage', de: 'Landschaft und Erbe' },
    title: { sq: 'Ishulli i Zvërnecit', en: 'Zvërnec Island', de: 'Insel Zvërnec' },
    text: {
      sq: 'Ishull i pyllëzuar me manastir, i lidhur me bregun me një urë druri.',
      en: 'A forested island with a monastery, linked to the shore by a wooden footbridge.',
      de: 'Eine bewaldete Insel mit einem Kloster, über einen Holzsteg mit dem Ufer verbunden.',
    },
  },
  {
    photo: 'pelikan',
    alt: { sq: 'Pelikan kaçurrel me krahë të hapur në bregun e kripëtoreve', en: 'A Dalmatian pelican with open wings on the shore of the salt pans', de: 'Ein Krauskopfpelikan mit ausgebreiteten Flügeln am Ufer der Salinen' },
    kicker: { sq: 'Shpendët e ujit', en: 'Waterbirds', de: 'Wasservögel' },
    title: { sq: 'Pelikani kaçurrel', en: 'Dalmatian pelican', de: 'Krauskopfpelikan' },
    text: {
      sq: 'Një nga shpendët më të mëdhenj të ujit në rajon, i fotografuar te kripëtoret.',
      en: 'One of the region’s largest waterbirds, photographed near the salt pans.',
      de: 'Einer der größten Wasservögel der Region, fotografiert an den Salinen.',
    },
  },
  {
    photo: 'gaforre',
    alt: { sq: 'Një gaforre jeshile në rërën e lagunës', en: 'A green crab on the sand of the lagoon', de: 'Eine grüne Krabbe im Sand der Lagune' },
    kicker: { sq: 'Jeta e vogël', en: 'Small life', de: 'Kleines Leben' },
    title: { sq: 'Gaforrja e lagunës', en: 'The lagoon crab', de: 'Die Lagunenkrabbe' },
    text: {
      sq: 'Zinxhiri ushqimor varet edhe nga kafshët e vogla që jetojnë në rërë dhe baltë.',
      en: 'The food chain also depends on the small creatures living in the sand and mud.',
      de: 'Die Nahrungskette hängt auch von den kleinen Lebewesen in Sand und Schlamm ab.',
    },
  },
  {
    photo: 'bregdeti',
    alt: { sq: 'Shkëmbinj bregdetarë që futen në det në Peizazhin e Mbrojtur Vjosë–Nartë', en: 'Coastal rocks meeting the sea in the Vjosë–Nartë Protected Landscape', de: 'Küstenfelsen, die in der geschützten Landschaft Vjosë–Nartë auf das Meer treffen' },
    kicker: { sq: 'Bregdeti', en: 'Coastline', de: 'Küste' },
    title: { sq: 'Bregu shkëmbor', en: 'The rocky shore', de: 'Die Felsenküste' },
    text: {
      sq: 'Shkëmbinj bregdetarë brenda Peizazhit të Mbrojtur Vjosë–Nartë.',
      en: 'Coastal rocks within the Vjosë–Nartë Protected Landscape.',
      de: 'Küstenfelsen innerhalb der geschützten Landschaft Vjosë–Nartë.',
    },
  },
] as const;

const copy = {
  sq: {
    title: 'Protestat',
    description: 'Protestat dhe aktivitetet e Flamingo Berlin.',
    heroEyebrow: 'Flamingo Berlin · Diaspora shqiptare',
    h1: 'Protestat në Berlin',
    lead: 'Protesta paqësore, informim qytetar dhe solidaritet me lëvizjen Flamingo Revolution.',
    heroCta: 'Shiko protestën e ardhshme',
