---
import { useTranslations, localePath } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href={localePath(lang, '/')} class="brand" aria-label="Flamingo Berlin">
        <span class="brand-mark"><img src="/assets/flamingo-logo.png" alt="" width="1254" height="1254" loading="lazy" decoding="async" /></span>
        <span class="brand-name">Flamingo <em>Berlin</em></span>
      </a>
      <p>{t('footer.tagline')}</p>
    </div>

    <div class="footer-column">
      <p class="footer-label">{t('footer.explore')}</p>
      <a href={localePath(lang, '/')}>{t('nav.protestat')}</a>
      <a href={localePath(lang, '/motivimi/')}>{t('nav.motivimi')}</a>
      <a href={localePath(lang, '/vepro/')}>{t('nav.vepro')}</a>
      <a href={localePath(lang, '/rreth-nesh/')}>{t('nav.rrethNesh')}</a>
    </div>

    <div class="footer-column">
      <p class="footer-label">{t('footer.connect')}</p>
      <a href="https://www.instagram.com/flamingosofberlin" target="_blank" rel="noreferrer">Instagram ↗</a>
      <a href="https://discord.gg/ZEvendesoje" target="_blank" rel="noreferrer">Discord ↗</a>
      <a href="mailto:Flamingo.berlin@gmx.de">Flamingo.berlin@gmx.de</a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} Flamingo Berlin</span>
    <span>{t('footer.rights')}</span>
  </div>
</footer>
